DATABASE_URL="postgresql://teampulse:teampulse@localhost:55432/teampulse"

# Linear: Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=""

# Slack user token (xoxp-). Scopes: channels:history, groups:history, im:history, users:read.
# A user token, not a bot token — a bot cannot see the DMs you sent.
SLACK_USER_TOKEN=""

# GitHub uses the `gh` CLI, already authenticated. No token here.

# Notion. Share every page or database you want counted with the integration —
# it sees nothing you have not shared with it.
# Prefer an *internal integration* secret over a personal access token: only the
# internal one may call /v1/users, which is how you look up the `notion:` ids for
# people.yaml. A personal token can retrieve nobody but itself, and the sync then
# reports the editor ids it could not name so you can map them by hand.
NOTION_API_KEY=""

# Google Calendar, via a Workspace service account with domain-wide delegation
# scoped to https://www.googleapis.com/auth/calendar.events.readonly.
# The JSON key itself, or a path to it. Each person's calendar is read by
# impersonating the `email` in people.yaml, which is what lets this see meetings
# you were never invited to.
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Vercel personal access token, plus the team id when the projects live in a team.
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# Anthropic ADMIN key (sk-ant-admin-), not a normal API key: the Claude Code
# analytics report lives on the Admin API. Console -> Settings -> Admin keys.
# Note the API only reports actors on API billing; anyone using Claude Code
# through a claude.ai subscription login does not appear in it at all.
ANTHROPIC_ADMIN_KEY=""

# Ordinary Anthropic API key (sk-ant-), used by the judgment layer in
# src/judgment.ts. Only POST /api/judge spends it; nothing else calls a model.
ANTHROPIC_API_KEY=""
