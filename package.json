{
  "name": "teampulse",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d && bunx prisma migrate deploy && bunx prisma generate",
    "db:down": "docker compose down",
    "ui": "bun run --hot src/server.ts",
    "mcp": "bun run src/mcp.ts",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun test",
    "prepare": "lefthook install",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.34",
    "@headlessui/react": "^2.2.10",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "ai": "^7.0.56",
    "google-auth-library": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-plugin-tailwind": "^0.1.2",
    "dotenv": "^17.4.2",
    "lefthook": "^2.1.10",
    "oxlint": "^1.77.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
