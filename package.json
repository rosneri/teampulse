{
  "name": "teampulse",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d && bunx prisma migrate deploy && bunx prisma generate",
    "db:down": "docker compose down",
    "sync": "bun run src/cli.ts sync",
    "team": "bun run src/cli.ts team",
    "person": "bun run src/cli.ts person",
    "test": "bun test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
