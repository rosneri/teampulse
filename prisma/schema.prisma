generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Facts. Every source collapses into this one table.
/// Nothing downstream (metrics, prompts, dashboard) knows what GitHub or Slack is.
model Activity {
  /// "<source>:<type>:<native id>" — stable across re-syncs, so sync is idempotent.
  id       String   @id
  source   String
  type     String
  personId String   @map("person_id")
  /// bug | feature | improvement | chore | other. Null = not classifiable yet.
  workType String?  @map("work_type")
  ts       DateTime @db.Timestamptz(3)
  url      String?
  title    String?
  body     String?
  meta     Json?

  @@index([personId, ts(sort: Desc)])
  @@index([type, ts(sort: Desc)])
  @@index([workType, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
  @@map("activity")
}

/// Current open Linear assignments. Not activity — it has no event timestamp of
/// its own. A snapshot, replaced wholesale each sync. Feeds the stale check.
model OpenIssue {
  id         String   @id
  identifier String
  title      String
  url        String
  personId   String   @map("person_id")
  state      String
  workType   String?  @map("work_type")
  priority   Int      @default(0)
  /// The Linear project this issue rolls up to, and the initiative that project
  /// belongs to. Both null when the issue sits under neither, and the initiative
  /// is also null when the workspace's plan does not expose initiatives at all —
  /// "no initiative" and "initiatives unavailable" are the same absence here.
  projectName    String? @map("project_name")
  initiativeName String? @map("initiative_name")
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)
  syncedAt   DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@index([personId])
  @@map("open_issue")
}

/// What a manager says a person should be on right now.
///
/// The third kind of row in this database, and deliberately not either of the
/// other two: it is not a fact collected from a source, and it is not a model's
/// opinion. It is an intention, typed by a person, and it is what the focus
/// brief compares observed activity against. One current statement per person —
/// an intention that has been superseded is not history worth keeping, it is
/// just a stale instruction.
model PersonFocus {
  personId String   @id @map("person_id")
  focus    String
  setAt    DateTime @default(now()) @map("set_at") @db.Timestamptz(3)

  @@map("person_focus")
}

/// Judgment, kept strictly apart from facts. Written by the AI layer only.
/// inputDigest hashes exactly what the model was shown, so any claim is traceable.
model AiOutput {
  id          BigInt   @id @default(autoincrement())
  kind        String
  personId    String   @map("person_id")
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd   DateTime @map("window_end") @db.Timestamptz(3)
  inputDigest String   @map("input_digest")
  payload     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([personId, kind, createdAt(sort: Desc)])
  @@map("ai_output")
}

model SyncRun {
  source  String   @id
  lastRun DateTime @map("last_run") @db.Timestamptz(3)

  @@map("sync_run")
}

/// What Claude Code cost and produced, per person per day.
/// Not activity: the analytics API buckets by calendar day, so these rows carry
/// no time of day and must never reach the hour-of-day or day-shape charts —
/// midnight is not when the work happened, it is only where the bucket starts.
/// Replaced per (person, day, model) on each sync, because a day's totals grow
/// until the day is over.
model AiUsage {
  personId    String   @map("person_id")
  /// Calendar day in UTC, as the analytics API reports it.
  day         DateTime @db.Date
  model       String
  sessions    Int      @default(0)
  inputTokens Int      @map("input_tokens") @default(0)
  outputTokens Int     @map("output_tokens") @default(0)
  cacheReadTokens Int  @map("cache_read_tokens") @default(0)
  cacheCreationTokens Int @map("cache_creation_tokens") @default(0)
  /// Minor units of `currency` — cents for USD, as the API reports it.
  costAmount  Int      @map("cost_amount") @default(0)
  currency    String   @default("USD")
  linesAdded  Int      @map("lines_added") @default(0)
  linesRemoved Int     @map("lines_removed") @default(0)
  commits     Int      @default(0)
  pullRequests Int     @map("pull_requests") @default(0)
  toolsAccepted Int    @map("tools_accepted") @default(0)
  toolsRejected Int    @map("tools_rejected") @default(0)
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)

  @@id([personId, day, model])
  @@index([day])
  @@map("ai_usage")
}
